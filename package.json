{
  "name": "aldia",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "cz",
    "preview": "vite preview",
    "optimize-logos": "node scripts/compress-images.mjs",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:tag": "node scripts/release-tag.mjs",
    "release:apk": "node scripts/release-apk.mjs"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/red-hat-text": "5.3.0",
    "colorthief": "^3.5.0",
    "flag-icons": "^7.6.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@types/colorthief": "^2.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
